# EVERYTHING BELOW IS OPTIONAL. With no keys, Claude is the brain and the server is fully homemade.
# Set LLM_* only if you want the server to also run autonomously (create_post / make_video).

# --- Required: any OpenAI-compatible LLM (OmniRoute, OpenRouter, OpenAI, Groq...) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4.5
LLM_CONCURRENCY=4
# Use a DIFFERENT model to grade so the writer isn't marking its own homework
JUDGE_MODEL=openai/gpt-4.1
# Any vision-capable model, used to QA rendered images
VISION_MODEL=google/gemini-2.5-flash

# --- Protect the endpoint (connect with .../api/mcp?key=THIS) ---
MCP_API_KEY=

# --- Optional: better images + real reel video (fal.ai) ---
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/dev
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
# Or an OpenAI-compatible image endpoint
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
# No image API by default (homemade = coded graphics + your photos). IMAGE_FALLBACK=pollinations to opt in.

# --- Optional: better research ---
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
YOUTUBE_API_KEY=

# --- Video (make_video) ---
# Voiceover with exact word-timed captions:
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ...or any OpenAI-compatible TTS:
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=ash
# Where MP4s are stored (pick one). Without these, links are temporary.
BLOB_READ_WRITE_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=hype-media
# Free/strict model tiers: space out calls
LLM_MIN_INTERVAL_MS=0

# Homemade voice (Kokoro, runs on the server): LOCAL_VOICE=am_michael  LOCAL_VOICE_SPEED=1.15  DISABLE_LOCAL_TTS=0
